{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "malgrind",
  "version": "0.4.0",
  "identifier": "dev.malgrind.app",
  "build": {
    "beforeDevCommand": "node scripts/build-sidecar.mjs && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/build-sidecar.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "malgrind", "width": 1280, "height": 800, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "valgrind for microcontrollers",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/malgrind-cli"],
    "macOS": { "minimumSystemVersion": "13.3", "signingIdentity": "-" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } },
    "resources": {
      "../../core/": "agent-src/core/",
      "../../platforms/": "agent-src/platforms/",
      "../../agent/": "agent-src/agent/"
    }
  }
}
